{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./src/types",
      "./node_modules/@types",
      "./src/types"
    ],
    "noResolve": true
  },
  "files": [
    "src/types/pal.d.ts",
    "src/types/rxjs-stub.d.ts",
    "src/js/pal/config.js",
    "src/js/pal/common.js",
    "src/js/pal/util-trace.js",
    "src/js/pal/utils.js",
    "src/js/pal/music.js",
    "src/js/pal/rng.js",
    "src/js/pal/ajax.js",
    "src/services/event-bus.ts",
    "src/services/environment-adapter.ts",
    "src/services/dialog-service.js",
    "src/services/game-flags-adapter.ts",
    "src/services/adapter-helpers.ts",
    "src/services/save-data-adapter.ts",
    "src/services/scene-state-adapter.ts",
    "src/services/scene-event-adapter.ts",
    "src/services/dialog-adapter.ts",
    "src/services/player-state-adapter.ts",
    "src/services/party-trail-adapter.ts",
    "src/services/game-data-adapter.ts",
    "src/services/state-service.ts",
    "src/services/resource-service.ts",
    "src/services/storage-service.ts",
    "src/services/scene-data-adapter.ts",
    "src/services/script-service.ts",
    "src/services/battle-service.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "pal-assets",
    "scripts/**/*",
    "tools/**/*",
    "test/**/*"
  ]
}
